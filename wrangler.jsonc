{
  "name": "uxman-gee-clothing",
  "main": "src/worker.js",
  "compatibility_date": "2026-08-26",

  "assets": {
    "directory": "./public",
    "binding": "ASSETS"
  },

  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "uxman-gee-reviews",
      "database_id": "YOUR_DATABASE_ID"
    }
  ]
}
